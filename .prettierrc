{
	"plugins": ["@prettier/plugin-oxc", "@ianvs/prettier-plugin-sort-imports"],
	"trailingComma": "all",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 110,
	"semi": true,
	"singleQuote": true,
	"bracketSpacing": true,

	"importOrder": [
		"<BUILTIN_MODULES>",
		"^bun(?::(.*))?$",
		"",
		"<THIRD_PARTY_MODULES>",
		"",
		"^\\.\\.",
		"",
		"^\\."
	],
	"importOrderTypeScriptVersion": "5.0.0",

	"overrides": [
		{
			"files": ["tsconfig.json", "jsconfig.json"],
			"options": {
				"parser": "jsonc"
			}
		},
		{
			"files": ["*.md"],
			"options": {
				"printWidth": 100,
				"proseWrap": "always"
			}
		}
	]
}
